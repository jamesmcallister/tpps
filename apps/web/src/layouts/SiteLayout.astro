---
import logoUrl from "../assets/logo.png";
import "../styles/index.css";
import { company } from "@tpps/content";
import { siteContent } from "../app/data/content";
import { serviceRoutes } from "../app/data/routes";

const currentYear = new Date().getFullYear();
const navLinks = siteContent.navigation.links.map((link) => {
  if (link.name === "Home") return { ...link, href: "/" };
  if (link.href.startsWith("#")) return { ...link, href: `/${link.href}` };
  return link;
});
const footerLinks = [
  { name: "Home", href: "/" },
  { name: "About", href: "/#about" },
  { name: "Work", href: "/#work" },
  { name: "Areas We Cover", href: "/#areas" },
  { name: "Contact", href: "/#contact" },
];

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath = "/",
  structuredData = [],
} = Astro.props;
const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const socialImageUrl = new URL("/og-image.jpg", Astro.site).toString();
const phoneHref = siteContent.contact.phone
  ? `tel:${siteContent.contact.phone.replace(/\s+/g, "")}`
  : undefined;
const emailHref = `mailto:${siteContent.contact.email}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="TPPS Landscapes patio and garden work across Thanet and East Kent"
    />
    <meta property="og:site_name" content={company.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
    {
      structuredData.map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
  </head>
  <body class="min-h-screen bg-stone-50 font-sans text-stone-900">
    <header
      id="site-header"
      class="fixed left-0 right-0 top-0 z-50 bg-white py-5 transition-all duration-300"
      data-site-header
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between">
          <a href="/" class="flex shrink-0 items-center gap-2">
            <img
              src={logoUrl.src}
              width={logoUrl.width}
              height={logoUrl.height}
              alt={`${siteContent.navigation.companyName} logo`}
              class="h-10 w-auto object-contain sm:h-12"
            />
            <span class="sr-only">{siteContent.navigation.companyName}</span>
          </a>

          <nav class="hidden items-center gap-6 lg:flex xl:gap-8" aria-label="Primary">
            {
              navLinks.map((link) => (
                <a
                  href={link.href}
                  class="text-sm font-medium text-stone-700 transition-colors hover:text-green-800"
                >
                  {link.name}
                </a>
              ))
            }
          </nav>

          <div class="hidden items-center gap-4 lg:flex">
            <a
              href={phoneHref ?? "/#contact"}
              aria-label={
                phoneHref ? `Call Now: TPPS Landscapes on ${siteContent.contact.phone}` : undefined
              }
              class="flex items-center gap-2 text-sm font-semibold text-stone-700 transition-colors hover:text-green-800"
            >
              <svg
                class="h-4 w-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                />
              </svg>
              <span>Call Now</span>
            </a>
            <a
              href="/#contact"
              class="rounded-md bg-green-800 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-green-900"
            >
              Get a Free Quote
            </a>
          </div>

          <button
            type="button"
            class="p-2 text-stone-600 hover:text-stone-900 lg:hidden"
            aria-label="Toggle menu"
            aria-expanded="false"
            aria-controls="mobile-nav"
            data-menu-button
          >
            <span class="block text-2xl leading-none" data-menu-icon>☰</span>
          </button>
        </div>
      </div>

      <nav
        id="mobile-nav"
        class="absolute left-0 right-0 top-full hidden flex-col gap-4 border-t border-stone-100 bg-white px-4 py-4 shadow-lg lg:hidden"
        aria-label="Mobile primary"
        data-mobile-nav
      >
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="block rounded-md px-4 py-2 font-medium text-stone-800 hover:bg-stone-50"
            >
              {link.name}
            </a>
          ))
        }
        <div class="flex flex-col gap-3 border-t border-stone-100 px-4 pt-4">
          <a
            href={phoneHref ?? "/#contact"}
            aria-label={
              phoneHref ? `Call Now: TPPS Landscapes on ${siteContent.contact.phone}` : undefined
            }
            class="flex w-full items-center justify-center gap-2 rounded-md border border-stone-300 py-3 font-semibold text-stone-800"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
              />
            </svg>
            <span>Call Now</span>
          </a>
          <a
            href="/#contact"
            class="flex w-full items-center justify-center rounded-md bg-green-800 py-3 font-semibold text-white"
          >
            Get a Free Quote
          </a>
        </div>
      </nav>
    </header>

    <main class="min-h-screen">
      <slot />
    </main>

    <footer class="mt-auto bg-stone-900 py-16 text-stone-300">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-4">
          <div class="flex flex-col gap-6">
            <a href="/" class="flex max-w-[200px] items-center gap-2">
              <span class="rounded bg-white p-2">
                <img
                  src={logoUrl.src}
                  width={logoUrl.width}
                  height={logoUrl.height}
                  alt={`${siteContent.navigation.companyName} logo`}
                  class="h-10 w-auto"
                />
              </span>
            </a>
            <p class="text-sm leading-relaxed text-stone-400">
              {siteContent.footer.companyDescription}
            </p>
            <p class="text-sm leading-relaxed text-stone-300">
              {siteContent.footer.seoSummary}
            </p>
          </div>

          <div>
            <h2 class="mb-6 font-semibold text-white">{siteContent.footer.quickLinksTitle}</h2>
            <ul class="flex flex-col gap-3">
              {
                footerLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="text-sm text-stone-400 transition-colors hover:text-green-500"
                    >
                      {link.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h2 class="mb-6 font-semibold text-white">Services</h2>
            <ul class="flex flex-col gap-3">
              {
                serviceRoutes.map(({ path, service }) => (
                  <li>
                    <a
                      href={path}
                      class="text-sm text-stone-400 transition-colors hover:text-green-500"
                    >
                      {service.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h2 class="mb-6 font-semibold text-white">{siteContent.footer.contactTitle}</h2>
            <div class="flex flex-col gap-4">
              {
                phoneHref && siteContent.contact.phone && (
                  <a href={phoneHref} class="group flex items-start gap-3">
                    <span class="mt-0.5 shrink-0 text-green-500 group-hover:text-green-400">
                      ☎
                    </span>
                    <span>
                      <span class="block font-medium text-white transition-colors group-hover:text-green-400">
                        {siteContent.contact.phone}
                      </span>
                      <span class="block text-xs text-stone-400">
                        {siteContent.footer.phoneLabel}
                      </span>
                    </span>
                  </a>
                )
              }
              <a href={emailHref} class="group flex items-start gap-3">
                <span class="mt-0.5 shrink-0 text-green-500 group-hover:text-green-400">@</span>
                <span class="text-sm text-stone-400 transition-colors group-hover:text-green-400">
                  {siteContent.contact.email}
                </span>
              </a>
              <div class="mt-2 flex items-start gap-3">
                <span class="mt-0.5 shrink-0 text-green-500">⌖</span>
                <span class="text-sm leading-relaxed text-stone-400">
                  {siteContent.footer.locationText}
                </span>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-16 border-t border-stone-800 pt-8">
          <p class="text-sm text-stone-400">
            &copy; {currentYear} {siteContent.footer.copyright}
          </p>
        </div>
      </div>
    </footer>

    <script>
      const header = document.querySelector("[data-site-header]");
      const menuButton = document.querySelector("[data-menu-button]");
      const menuIcon = document.querySelector("[data-menu-icon]");
      const mobileNav = document.querySelector("[data-mobile-nav]");

      const setHeaderState = () => {
        if (!header) return;
        header.classList.toggle("py-3", window.scrollY > 20);
        header.classList.toggle("py-5", window.scrollY <= 20);
        header.classList.toggle("shadow-sm", window.scrollY > 20);
        header.classList.toggle("bg-white/95", window.scrollY > 20);
        header.classList.toggle("backdrop-blur-md", window.scrollY > 20);
      };

      menuButton?.addEventListener("click", () => {
        const isOpen = menuButton.getAttribute("aria-expanded") === "true";
        menuButton.setAttribute("aria-expanded", String(!isOpen));
        mobileNav?.classList.toggle("hidden", isOpen);
        mobileNav?.classList.toggle("flex", !isOpen);
        if (menuIcon) menuIcon.textContent = isOpen ? "☰" : "×";
      });

      mobileNav?.addEventListener("click", (event) => {
        if (!(event.target instanceof HTMLAnchorElement)) return;
        menuButton?.setAttribute("aria-expanded", "false");
        mobileNav.classList.add("hidden");
        mobileNav.classList.remove("flex");
        if (menuIcon) menuIcon.textContent = "☰";
      });

      document.querySelectorAll("[data-gallery]").forEach((gallery) => {
        const images = Array.from(gallery.querySelectorAll("[data-gallery-image]"));
        const dots = Array.from(gallery.querySelectorAll("[data-gallery-dot]"));
        const current = gallery.querySelector("[data-gallery-current]");
        const prev = gallery.querySelector("[data-gallery-prev]");
        const next = gallery.querySelector("[data-gallery-next]");
        let index = 0;
        let touchStartX = 0;
        let pointerStartX = 0;

        const show = (nextIndex) => {
          if (!images.length) return;
          index = (nextIndex + images.length) % images.length;
          images.forEach((image, imageIndex) => {
            image.hidden = imageIndex !== index;
          });
          dots.forEach((dot, dotIndex) => {
            if (dotIndex === index) {
              dot.setAttribute("aria-current", "true");
            } else {
              dot.removeAttribute("aria-current");
            }
          });
          if (current) current.textContent = String(index + 1);
        };

        prev?.addEventListener("click", () => show(index - 1));
        next?.addEventListener("click", () => show(index + 1));
        dots.forEach((dot) => {
          dot.addEventListener("click", () => {
            show(Number(dot.getAttribute("data-gallery-index") ?? 0));
          });
        });
        gallery.addEventListener(
          "touchstart",
          (event) => {
            touchStartX = event.changedTouches[0]?.clientX ?? 0;
          },
          { passive: true },
        );
        gallery.addEventListener(
          "touchend",
          (event) => {
            const touchEndX = event.changedTouches[0]?.clientX ?? 0;
            const delta = touchEndX - touchStartX;
            if (Math.abs(delta) < 40) return;
            show(delta < 0 ? index + 1 : index - 1);
          },
          { passive: true },
        );
        gallery.addEventListener("pointerdown", (event) => {
          pointerStartX = event.clientX;
        });
        gallery.addEventListener("pointerup", (event) => {
          const delta = event.clientX - pointerStartX;
          if (Math.abs(delta) < 40) return;
          show(delta < 0 ? index + 1 : index - 1);
        });
      });

      setHeaderState();
      window.addEventListener("scroll", setHeaderState, { passive: true });
    </script>
  </body>
</html>
