---
import { company, pricingPolicy } from "@tpps/content";
import { serviceRoutes } from "../../app/data/routes";
import SiteLayout from "../../layouts/SiteLayout.astro";

export function getStaticPaths() {
  return serviceRoutes.map(({ service }) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const title = `${service.name} across Thanet & East Kent | ${company.shortName}`;
const description = `${service.description} ${company.shortName} covers Thanet and East Kent, including Canterbury, Dover, Folkestone, Hythe, Whitstable, Herne Bay, Sandwich and Deal.`;
const canonicalPath = `/services/${service.id}/`;
const relatedServices = serviceRoutes.filter(({ service: item }) => item.id !== service.id).slice(0, 3);
const tags = service.tags ?? [];

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.name,
  description: service.description,
  provider: {
    "@type": "LocalBusiness",
    name: company.name,
    ...(company.contact.phone ? { telephone: company.contact.phone } : {}),
    email: company.contact.email,
    url: "https://www.tppslandscapes.co.uk/",
  },
  areaServed: company.location.towns.map((town) => ({ "@type": "Place", name: town })),
  serviceType: service.name,
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://www.tppslandscapes.co.uk/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: service.name,
      item: `https://www.tppslandscapes.co.uk${canonicalPath}`,
    },
  ],
};
---

<SiteLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  structuredData={[serviceJsonLd, breadcrumbJsonLd]}
>
  <article class="bg-white pt-24">
    <header class="border-b border-stone-200 bg-stone-50 py-16">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <nav class="mb-8 text-sm text-stone-500" aria-label="Breadcrumb">
          <a href="/" class="hover:text-green-800">Home</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <span>{service.name}</span>
        </nav>
        <h1 class="mb-6 text-4xl font-bold leading-tight text-stone-900 md:text-5xl">
          {service.name} across Thanet and East Kent
        </h1>
        <p class="max-w-3xl text-lg leading-relaxed text-stone-600 md:text-xl">
          {service.description}
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a
            href={`mailto:${company.contact.email}?subject=${encodeURIComponent(`${service.name} quote request`)}`}
            class="rounded-md bg-green-800 px-6 py-3 text-center font-semibold text-white hover:bg-green-900"
          >
            Request a free quote
          </a>
          {
            company.contact.phone ? (
              <a
                href={`tel:${company.contact.phone.replace(/\s+/g, "")}`}
                class="rounded-md border border-stone-300 px-6 py-3 text-center font-semibold text-stone-800 hover:border-green-800 hover:text-green-800"
              >
                Call {company.contact.phone}
              </a>
            ) : (
              <a
                href="/#services"
                class="rounded-md border border-stone-300 px-6 py-3 text-center font-semibold text-stone-800 hover:border-green-800 hover:text-green-800"
              >
                View services
              </a>
            )
          }
        </div>
      </div>
    </header>

    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_320px] lg:px-8">
      <div class="space-y-14">
        <section>
          <h2 class="mb-4 text-2xl font-bold text-stone-900">What We Cover</h2>
          <p class="text-lg leading-relaxed text-stone-600">
            We plan the work around your property, access, drainage, ground conditions, and the
            finish you want. Every quote is confirmed after a site visit so materials, preparation,
            waste removal, and timescales are clear before work begins.
          </p>
          {
            tags.length > 0 && (
              <ul class="mt-6 flex flex-wrap gap-3">
                {tags.map((tag) => (
                  <li class="rounded-full border border-stone-200 bg-stone-50 px-4 py-2 text-sm font-medium text-stone-700">
                    {tag}
                  </li>
                ))}
              </ul>
            )
          }
        </section>

        <section>
          <h2 class="mb-4 text-2xl font-bold text-stone-900">Areas Served</h2>
          <p class="text-lg leading-relaxed text-stone-600">
            {company.shortName} provides {service.name.toLowerCase()} across {company.location.area},
            including {company.location.towns.join(", ")} and nearby towns by request.
          </p>
        </section>

        <section>
          <h2 class="mb-4 text-2xl font-bold text-stone-900">Common Questions</h2>
          <div class="space-y-5">
            <div>
              <h3 class="font-semibold text-stone-900">Do you provide free quotes?</h3>
              <p class="mt-1 text-stone-600">{pricingPolicy.surveyPolicy}</p>
            </div>
            <div>
              <h3 class="font-semibold text-stone-900">How do quotes work?</h3>
              <p class="mt-1 text-stone-600">{pricingPolicy.quoteTimeline}</p>
            </div>
            <div>
              <h3 class="font-semibold text-stone-900">What affects the cost?</h3>
              <p class="mt-1 text-stone-600">{pricingPolicy.notes[1]}</p>
            </div>
          </div>
        </section>
      </div>

      <aside class="h-fit rounded-lg border border-stone-200 bg-stone-50 p-6">
        <h2 class="mb-4 text-lg font-bold text-stone-900">Related Services</h2>
        <ul class="space-y-3">
          {
            relatedServices.map(({ path, service: item }) => (
              <li>
                <a href={path} class="font-medium text-green-800 hover:text-green-900">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href="/#contact"
          class="mt-8 block rounded-md bg-green-800 px-5 py-3 text-center font-semibold text-white hover:bg-green-900"
        >
          Talk through your project
        </a>
      </aside>
    </div>
  </article>
</SiteLayout>
