---
import { company, pricingPolicy } from "@tpps/content";
import { serviceRoutes } from "../../app/data/routes";
import SiteLayout from "../../layouts/SiteLayout.astro";
import patioPathways01 from "../../assets/patios-pathways-01.jpeg";
import patioPathways02 from "../../assets/patios-pathways-02.jpeg";
import patioPathways03 from "../../assets/patios-pathways-03.jpeg";
import patioPathways04 from "../../assets/patios-pathways-04.jpeg";
import patioPathways05 from "../../assets/patios-pathways-05.jpeg";
import patioPathways06 from "../../assets/patios-pathways-06.jpeg";
import patioPathways07 from "../../assets/patios-pathways-07.jpeg";
import patioPathways08 from "../../assets/patios-pathways-08.jpeg";
import patioPathways09 from "../../assets/patios-pathways-09.jpeg";
import patioPathways10 from "../../assets/patios-pathways-10.jpeg";
import fencing01 from "../../assets/fencing-01.jpeg";
import fencing02 from "../../assets/fencing-02.jpeg";
import fencing03 from "../../assets/fencing-03.jpeg";
import fencing04 from "../../assets/fencing-04.jpeg";
import fencing05 from "../../assets/fencing-05.jpeg";
import fencing06 from "../../assets/fencing-06.jpeg";
import fencing07 from "../../assets/fencing-07.jpeg";
import fencing08 from "../../assets/fencing-08.jpeg";
import fencing09 from "../../assets/fencing-09.jpeg";
import fencing10 from "../../assets/fencing-10.jpeg";
import fencing11 from "../../assets/fencing-11.jpeg";
import fencing12 from "../../assets/fencing-12.jpeg";
import fencing13 from "../../assets/fencing-13.jpeg";
import fencing14 from "../../assets/fencing-14.jpeg";
import fencing15 from "../../assets/fencing-15.jpeg";
import fencing16 from "../../assets/fencing-16.jpeg";

export function getStaticPaths() {
  return serviceRoutes.map(({ service }) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const title = `${service.name} across Thanet & East Kent | ${company.shortName}`;
const description = `${service.description} ${company.shortName} covers Thanet and East Kent, including Canterbury, Dover, Folkestone, Whitstable, Herne Bay, Sandwich and Deal.`;
const canonicalPath = `/services/${service.id}/`;
const relatedServices = serviceRoutes.filter(({ service: item }) => item.id !== service.id).slice(0, 3);
const tags = service.tags ?? [];
const serviceGalleries = {
  "patios-pathways": {
    heading: "Patios and pathways gallery",
    description:
      "Swipe through recent patio and pathway work, from preparation through to finished garden spaces.",
    images: [
      {
        src: patioPathways01.src,
        alt: "Finished patio and pathway wrapping around a garden lawn and planting bed",
      },
      {
        src: patioPathways02.src,
        alt: "Finished sandstone patio with screen fencing and an open seating area",
      },
      {
        src: patioPathways03.src,
        alt: "Patio slabs being laid with levelling spacers during installation",
      },
      {
        src: patioPathways04.src,
        alt: "Finished garden patio with outdoor dining furniture and planting pots",
      },
      {
        src: patioPathways05.src,
        alt: "Finished patio seating area beside a lawn and timber fencing",
      },
      {
        src: patioPathways06.src,
        alt: "Finished patio dining area beside a house and lawn",
      },
      {
        src: patioPathways07.src,
        alt: "Finished patio area around a garden room with gravel edging",
      },
      {
        src: patioPathways08.src,
        alt: "Finished paved area around a garden shed and trellis fence",
      },
      {
        src: patioPathways09.src,
        alt: "Large finished patio area with lawn and raised timber edging",
      },
      {
        src: patioPathways10.src,
        alt: "Finished patio path leading through a landscaped back garden",
      },
    ],
  },
  fencing: {
    heading: "Fencing gallery",
    description:
      "Swipe through recent fencing work, from screen fencing and garden gates to longer boundary runs.",
    images: [
      {
        src: fencing01.src,
        alt: "Finished horizontal timber screen fencing beside a paved patio",
      },
      {
        src: fencing02.src,
        alt: "Finished timber screen fencing and gate around a decked garden area",
      },
      {
        src: fencing03.src,
        alt: "Paved patio area enclosed by new timber fencing",
      },
      {
        src: fencing04.src,
        alt: "Timber screen fencing and decking during installation",
      },
      {
        src: fencing05.src,
        alt: "Timber screen fencing installed around raised decking joists",
      },
      {
        src: fencing06.src,
        alt: "Finished timber screen fencing with gate and decked seating area",
      },
      {
        src: fencing07.src,
        alt: "Long back garden with newly installed timber boundary fencing",
      },
      {
        src: fencing08.src,
        alt: "New fence panels and concrete posts enclosing a cleared garden corner",
      },
      {
        src: fencing09.src,
        alt: "Fence panels fitted around a mature tree with concrete posts",
      },
      {
        src: fencing10.src,
        alt: "New timber boundary fencing beside a garden digger during landscaping work",
      },
      {
        src: fencing11.src,
        alt: "Long run of new timber boundary fencing across a cleared garden",
      },
      {
        src: fencing12.src,
        alt: "New garden boundary fencing following the line of a large back garden",
      },
      {
        src: fencing13.src,
        alt: "Finished fence panels and concrete gravel boards around a cleared garden",
      },
      {
        src: fencing14.src,
        alt: "Finished timber fencing around a cleared garden area",
      },
      {
        src: fencing15.src,
        alt: "Long garden with new fence panels installed along both boundaries",
      },
      {
        src: fencing16.src,
        alt: "Patio installation area bordered by new timber fencing",
      },
    ],
  },
};
const gallery = serviceGalleries[service.id as keyof typeof serviceGalleries];

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.name,
  description: service.description,
  provider: {
    "@type": "LocalBusiness",
    name: company.name,
    ...(company.contact.phone ? { telephone: company.contact.phone } : {}),
    email: company.contact.email,
    url: "https://www.tppslandscapes.com/",
  },
  areaServed: company.location.towns.map((town) => ({ "@type": "Place", name: town })),
  serviceType: service.name,
};

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://www.tppslandscapes.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: service.name,
      item: `https://www.tppslandscapes.com${canonicalPath}`,
    },
  ],
};
---

<SiteLayout
  title={title}
  description={description}
  canonicalPath={canonicalPath}
  structuredData={[serviceJsonLd, breadcrumbJsonLd]}
>
  <article class="bg-white pt-24">
    <header class="border-b border-stone-200 bg-stone-50 py-16">
      <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <nav class="mb-8 text-sm text-stone-500" aria-label="Breadcrumb">
          <a href="/" class="hover:text-green-800">Home</a>
          <span aria-hidden="true" class="mx-2">/</span>
          <span>{service.name}</span>
        </nav>
        <h1 class="mb-6 text-4xl font-bold leading-tight text-stone-900 md:text-5xl">
          {service.name} across Thanet and East Kent
        </h1>
        <p class="max-w-3xl text-lg leading-relaxed text-stone-600 md:text-xl">
          {service.description}
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row">
          <a
            href={`mailto:${company.contact.email}?subject=${encodeURIComponent(`${service.name} quote request`)}`}
            class="rounded-md bg-green-800 px-6 py-3 text-center font-semibold text-white hover:bg-green-900"
          >
            Request a quote
          </a>
          {
            company.contact.phone ? (
              <a
                href={`tel:${company.contact.phone.replace(/\s+/g, "")}`}
                class="rounded-md border border-stone-300 px-6 py-3 text-center font-semibold text-stone-800 hover:border-green-800 hover:text-green-800"
              >
                Call {company.contact.phone}
              </a>
            ) : (
              <a
                href="/#services"
                class="rounded-md border border-stone-300 px-6 py-3 text-center font-semibold text-stone-800 hover:border-green-800 hover:text-green-800"
              >
                View services
              </a>
            )
          }
        </div>
      </div>
    </header>

    <div class="mx-auto grid max-w-6xl grid-cols-1 gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1fr_320px] lg:px-8">
      <div class="space-y-14">
        <section>
          <h2 class="mb-4 text-2xl font-bold text-stone-900">What We Cover</h2>
          <p class="text-lg leading-relaxed text-stone-600">
            We plan the work around your property, access, drainage, ground conditions, and the
            finish you want. Every quote is confirmed after a site visit so materials, preparation,
            waste removal, and timescales are clear before work begins.
          </p>
          {
            tags.length > 0 && (
              <ul class="mt-6 flex flex-wrap gap-3">
                {tags.map((tag) => (
                  <li class="rounded-full border border-stone-200 bg-stone-50 px-4 py-2 text-sm font-medium text-stone-700">
                    {tag}
                  </li>
                ))}
              </ul>
            )
          }
        </section>

        {
          gallery && (
            <section>
              <div class="mb-6">
                <h2 class="mb-3 text-2xl font-bold text-stone-900">{gallery.heading}</h2>
                <p class="text-lg leading-relaxed text-stone-600">{gallery.description}</p>
              </div>
              <div
                class="relative overflow-hidden rounded-2xl bg-stone-900 shadow-2xl"
                data-gallery
                aria-roledescription="carousel"
                aria-label={`${service.name} project photos`}
              >
                <div class="aspect-[4/3] w-full">
                  {gallery.images.map((image, index) => (
                    <img
                      src={image.src}
                      alt={image.alt}
                      class="h-full w-full object-cover"
                      data-gallery-image
                      hidden={index !== 0}
                      loading={index === 0 ? "eager" : "lazy"}
                      decoding="async"
                    />
                  ))}
                </div>
                <button
                  type="button"
                  class="absolute left-4 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-stone-900 shadow-lg transition-colors hover:bg-white focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-stone-900"
                  data-gallery-prev
                  aria-label="Previous photo"
                >
                  <span aria-hidden="true" class="text-2xl leading-none">
                    &lsaquo;
                  </span>
                </button>
                <button
                  type="button"
                  class="absolute right-4 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white/90 text-stone-900 shadow-lg transition-colors hover:bg-white focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-stone-900"
                  data-gallery-next
                  aria-label="Next photo"
                >
                  <span aria-hidden="true" class="text-2xl leading-none">
                    &rsaquo;
                  </span>
                </button>
                <div class="absolute bottom-4 left-4 rounded-full bg-stone-900/70 px-3 py-1 text-sm font-semibold text-white backdrop-blur-sm">
                  <span data-gallery-current>1</span> / {gallery.images.length}
                </div>
                <div class="absolute bottom-4 right-4 flex gap-2" aria-label="Choose photo">
                  {gallery.images.map((image, index) => (
                    <button
                      type="button"
                      class="h-2.5 w-2.5 rounded-full bg-white/50 transition-colors aria-current:bg-white"
                      data-gallery-dot
                      data-gallery-index={index}
                      aria-label={`Show photo ${index + 1}`}
                      aria-current={index === 0 ? "true" : undefined}
                    />
                  ))}
                </div>
              </div>
            </section>
          )
        }

        <section>
          <h2 class="mb-4 text-2xl font-bold text-stone-900">Areas Served</h2>
          <p class="text-lg leading-relaxed text-stone-600">
            {company.shortName} provides {service.name.toLowerCase()} across {company.location.area},
            including {company.location.towns.join(", ")} and nearby towns by request.
          </p>
        </section>

        <section>
          <h2 class="mb-4 text-2xl font-bold text-stone-900">Common Questions</h2>
          <div class="space-y-5">
            <div>
              <h3 class="font-semibold text-stone-900">Do you provide free quotes?</h3>
              <p class="mt-1 text-stone-600">{pricingPolicy.surveyPolicy}</p>
            </div>
            <div>
              <h3 class="font-semibold text-stone-900">How do quotes work?</h3>
              <p class="mt-1 text-stone-600">{pricingPolicy.quoteTimeline}</p>
            </div>
            <div>
              <h3 class="font-semibold text-stone-900">What affects the cost?</h3>
              <p class="mt-1 text-stone-600">{pricingPolicy.notes[1]}</p>
            </div>
          </div>
        </section>
      </div>

      <aside class="h-fit rounded-lg border border-stone-200 bg-stone-50 p-6">
        <h2 class="mb-4 text-lg font-bold text-stone-900">Related Services</h2>
        <ul class="space-y-3">
          {
            relatedServices.map(({ path, service: item }) => (
              <li>
                <a href={path} class="font-medium text-green-800 hover:text-green-900">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
        <a
          href="/#contact"
          class="mt-8 block rounded-md bg-green-800 px-5 py-3 text-center font-semibold text-white hover:bg-green-900"
        >
          Talk through your project
        </a>
      </aside>
    </div>
  </article>
</SiteLayout>
