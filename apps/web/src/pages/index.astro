---
import { company } from "@tpps/content";
import SiteLayout from "../layouts/SiteLayout.astro";
import { Home } from "../app/pages/Home";

const title = "TPPS Landscapes Ltd | Landscaping, Patios & Driveways in East Kent";
const description =
  "Local landscaping and groundworks across Thanet and East Kent, including patios, driveways, fencing, drainage, garden renovation, and site clearance.";

const localBusinessJsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: company.name,
  url: "https://www.tppslandscapes.co.uk/",
  ...(company.contact.phone ? { telephone: company.contact.phone } : {}),
  email: company.contact.email,
  description: company.description.short,
  areaServed: company.location.towns.map((town) => ({
    "@type": "Place",
    name: town,
  })),
  serviceArea: {
    "@type": "AdministrativeArea",
    name: company.location.area,
  },
  knowsAbout: [
    "Landscaping",
    "Patios",
    "Driveways",
    "Fencing",
    "Groundworks",
    "Garden design",
    "Garden maintenance",
  ],
};
---

<SiteLayout title={title} description={description} structuredData={[localBusinessJsonLd]}>
  <Home />
</SiteLayout>
