---
import { company, homepageSeo } from "@tpps/content";
import SiteLayout from "../layouts/SiteLayout.astro";
import { Home } from "../app/pages/Home";

const localBusinessJsonLd = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "LandscapingBusiness"],
  name: company.name,
  url: homepageSeo.canonicalUrl,
  image: homepageSeo.socialImage,
  ...(company.contact.phone ? { telephone: company.contact.phone } : {}),
  email: company.contact.email,
  description: company.description.short,
  areaServed: homepageSeo.serviceAreas.map((town) => ({
    "@type": "Place",
    name: town,
  })),
  serviceArea: {
    "@type": "AdministrativeArea",
    name: homepageSeo.serviceAreaRegion,
  },
  knowsAbout: homepageSeo.knowsAbout,
};
---

<SiteLayout
  title={homepageSeo.title}
  description={homepageSeo.description}
  structuredData={[localBusinessJsonLd]}
>
  <Home />
</SiteLayout>
