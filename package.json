{
  "name": "tpps-monorepo",
  "private": true,
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "dev:web": "pnpm --filter web run dev",
    "build:web": "pnpm --filter web run build",
    "test:web:e2e": "pnpm --filter web run test:e2e",
    "test:web:lighthouse": "pnpm --filter web run test:lighthouse",
    "deploy:web": "pnpm --filter web run deploy",
    "dev:email": "pnpm --filter email run dev",
    "build:email": "pnpm --filter email run build",
    "deploy:email": "pnpm --filter email run deploy",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,md}": [
      "oxlint --fix",
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485"
}
